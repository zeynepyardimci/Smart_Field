# Smart Field - Environment Configuration Example
# Do not commit real secrets or credentials to source control.

RAILS_ENV=development
RAILS_MAX_THREADS=5
PORT=3000

# Secret Key Base for Rails session encryption (generate with: rails secret)
SECRET_KEY_BASE=replace_with_a_secure_random_64_character_hex_string

# Production Database (PostgreSQL on Render / Railway / Koyeb)
# DATABASE_URL=postgresql://username:password@hostname:5432/smart_field_production
